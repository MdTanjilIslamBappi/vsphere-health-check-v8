<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ config.report.title }}</title>
<style>
  :root {
    --sev-critical: #b30000; --sev-high: #d9534f; --sev-medium: #c77c00;
    --sev-low: #5b8def; --sev-info: #6c757d;
    --status-healthy: #1e7e34; --status-informational: #5b8def;
    --status-advisory: #c77c00; --status-attention: #b30000; --status-notassessed: #6c757d;
  }
  body { font-family: -apple-system, Segoe UI, Arial, sans-serif; margin: 0; color: #1a1a1a; }
  header { background: #1b2a4a; color: #fff; padding: 2rem; }
  header h1 { margin: 0 0 0.25rem; font-size: 1.6rem; }
  header .meta { opacity: 0.85; font-size: 0.9rem; }
  main { max-width: 960px; margin: 0 auto; padding: 1.5rem 2rem 3rem; }
  section { margin-bottom: 2.5rem; }
  h2 { border-bottom: 2px solid #1b2a4a; padding-bottom: 0.3rem; }
  table { width: 100%; border-collapse: collapse; margin: 0.75rem 0 1.5rem; font-size: 0.9rem; }
  th, td { border: 1px solid #ddd; padding: 0.5rem 0.65rem; text-align: left; vertical-align: top; }
  th { background: #f3f4f6; }
  .badge { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 1rem; color: #fff;
           font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
  .badge.critical { background: var(--sev-critical); }
  .badge.high { background: var(--sev-high); }
  .badge.medium { background: var(--sev-medium); }
  .badge.low { background: var(--sev-low); }
  .badge.info { background: var(--sev-info); }
  .status { font-weight: 700; }
  .status.healthy { color: var(--status-healthy); }
  .status.informational { color: var(--status-informational); }
  .status.advisory { color: var(--status-advisory); }
  .status.attention-needed { color: var(--status-attention); }
  .status.not-assessed { color: var(--status-notassessed); }
  .summary-counts { display: flex; gap: 1rem; flex-wrap: wrap; }
  .summary-counts div { flex: 1; min-width: 120px; border: 1px solid #ddd; border-radius: 6px;
                         padding: 0.75rem 1rem; }
  .summary-counts .count { font-size: 1.8rem; font-weight: 700; }
  .finding { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; margin-bottom: 0.75rem; }
  .finding h3 { margin: 0.2rem 0; }
  .evidence { background: #f8f9fa; border-left: 3px solid #999; padding: 0.5rem 0.75rem;
              font-family: Consolas, monospace; font-size: 0.8rem; margin-top: 0.5rem; white-space: pre-wrap; }
  .muted { color: #666; font-size: 0.85rem; }
  .toc a { color: #1b2a4a; text-decoration: none; }
  .toc a:hover { text-decoration: underline; }
  footer { text-align: center; color: #888; font-size: 0.8rem; padding: 1.5rem; }
</style>
</head>
<body>
<header>
  <h1>{{ config.report.title }}</h1>
  {% if config.report.company_name %}<div class="meta">{{ config.report.company_name }}</div>{% endif %}
  <div class="meta">Generated {{ assessment.metadata.assessment_timestamp }} &middot;
     vhealth {{ assessment.metadata.app_version }} &middot;
     rule engine {{ assessment.metadata.rule_engine_version }}</div>
  <div class="meta">Input: {{ assessment.metadata.input_filename }}
     (sha256 {{ assessment.metadata.input_sha256[:16] }}&hellip;)</div>
  {% if authorship.engineer_name or authorship.author or authorship.verifier %}
  <div class="meta">
    {% if authorship.engineer_name %}Engineer: {{ authorship.engineer_name }}{% endif %}
    {% if authorship.author %}{% if authorship.engineer_name %} &middot; {% endif %}Author: {{ authorship.author }}{% endif %}
    {% if authorship.verifier %}{% if authorship.engineer_name or authorship.author %} &middot; {% endif %}Verified by: {{ authorship.verifier }}{% endif %}
  </div>
  {% endif %}
</header>
<main>

<section id="version-history">
  <h2>Version History</h2>
  <table>
    <tr><th>Date</th><th>Rev.</th><th>Author</th><th>Description</th></tr>
    <tr>
      <td>{{ assessment.metadata.assessment_timestamp.split("T")[0] }}</td>
      <td>{{ authorship.revision }}</td>
      <td>{{ authorship.author or authorship.engineer_name or "" }}</td>
      <td>{{ authorship.description }}</td>
    </tr>
  </table>
</section>

<section id="contents" class="toc">
  <h2>Contents</h2>
  <ul>
    <li><a href="#executive-summary">1. Executive Summary</a></li>
    <li><a href="#scope">2. Scope of Health Check</a></li>
    <li><a href="#system-status">3. System Status</a>
      <ul>
        <li><a href="#hardware-status">3.1 Current Hardware Status</a></li>
        <li><a href="#component-status">3.2 Current State Analysis of VMware Components</a></li>
        <li><a href="#host-inventory">3.3 Current State Analysis of ESXi Hosts</a></li>
        <li><a href="#detailed-findings">3.4 Detailed Findings</a></li>
        <li><a href="#not-assessed">3.5 Not Assessed From This Bundle</a></li>
        <li><a href="#recommendation">3.6 Recommendation</a></li>
      </ul>
    </li>
  </ul>
</section>

<section id="executive-summary">
  <h2>1. Executive Summary</h2>
  <div class="summary-counts">
    {% for sev in ["critical", "high", "medium", "low", "info"] %}
    <div>
      <div class="count">{{ severity_counts.get(sev, 0) }}</div>
      <div class="badge {{ sev }}">{{ sev }}</div>
    </div>
    {% endfor %}
  </div>
  <p>{{ executive_summary }}</p>
  <p class="muted">{{ hosts|length }} ESXi host(s) were assessed from this support bundle.
     {{ findings|length }} finding(s) were raised across {{ rule_count }} automated checks.</p>
</section>

<section id="scope">
  <h2>2. Scope of Health Check</h2>
  <p>This report was produced entirely offline from the customer-supplied diagnostic bundle below;
     no connection was made to any vCenter Server, ESXi host, or external service.</p>
  <table>
    <tr><th>Input file</th><td>{{ assessment.metadata.input_filename }}</td></tr>
    <tr><th>SHA-256</th><td>{{ assessment.metadata.input_sha256 }}</td></tr>
    <tr><th>Hosts discovered</th><td>{{ hosts|length }}</td></tr>
    <tr><th>Assessment schema</th><td>{{ assessment.metadata.schema_version }}</td></tr>
  </table>
  <p><strong>Checked by this assessment:</strong></p>
  <ul>{% for item in scope_checked %}<li>{{ item }}</li>{% endfor %}</ul>
  <p><strong>Not checked by this assessment</strong> (see Section 3.5):</p>
  <ul>{% for item in scope_not_assessed %}<li>{{ item }}</li>{% endfor %}</ul>
  {% if assessment.metadata.processing_warnings %}
  <p class="muted">Processing warnings ({{ assessment.metadata.processing_warnings|length }}):</p>
  <ul class="muted">
    {% for w in assessment.metadata.processing_warnings %}<li>{{ w.source }}: {{ w.message }}</li>{% endfor %}
  </ul>
  {% endif %}
</section>

<section id="system-status">
  <h2>3. System Status</h2>

  <h3 id="hardware-status">3.1 Current Hardware Status</h3>
  <table>
    <tr><th>Category</th><th>Status</th></tr>
    {% for row in hardware_status_rows %}
    <tr><td>{{ row.label }}</td><td class="status {{ row.status|lower|replace(' ', '-') }}">{{ row.status }}</td></tr>
    {% endfor %}
  </table>
  <p class="muted">Derived from the storage, SMART, and IPMI sensor findings in this assessment.
     &ldquo;Management Connection Status&rdquo; requires live vCenter/ESXi connectivity and is not
     assessed from a static bundle.</p>

  <h3 id="component-status">3.2 Current State Analysis of VMware Components</h3>
  <table>
    <tr><th>Component</th><th>Status</th><th>Remarks</th></tr>
    {% for row in component_status_rows %}
    <tr>
      <td>{{ row.component }}</td>
      <td class="status {{ row.status|lower|replace(' ', '-') }}">{{ row.status }}</td>
      <td>{{ row.remarks }}</td>
    </tr>
    {% endfor %}
  </table>

  <h3 id="host-inventory">3.3 Current State Analysis of ESXi Hosts</h3>
  <table>
    <tr><th>S.No</th><th>Server Name</th><th>Management IP</th><th>Server Model</th><th>CPU Model</th></tr>
    {% for row in host_inventory_rows %}
    <tr>
      <td>{{ row.index }}</td>
      <td>{{ row.hostname }}</td>
      <td>{{ row.management_ip }}</td>
      <td>{{ row.server_model }}</td>
      <td>{{ row.cpu_model }}</td>
    </tr>
    {% endfor %}
  </table>

  <h3 id="detailed-findings">3.4 Detailed Findings</h3>
  {% for f in findings %}
  <div class="finding">
    <span class="badge {{ f.severity.value }}">{{ f.severity.value }}</span>
    <h3>{{ f.title }}</h3>
    <p class="muted">{{ f.rule_id }}{% if f.affected_host %} &middot; {{ f.affected_host }}{% endif %}
       {% if f.affected_object %} &middot; {{ f.affected_object }}{% endif %}</p>
    <p>{{ f.summary }}</p>
    {% if f.remediation %}<p><strong>Remediation:</strong> {{ f.remediation }}</p>{% endif %}
    {% if f.limitations %}<p class="muted"><strong>Limitations:</strong> {{ f.limitations }}</p>{% endif %}
    {% if f.evidence %}<div class="evidence">{{ f.evidence|join("\n") }}</div>{% endif %}
  </div>
  {% else %}
  <p>No findings were raised by the rule catalogue for this bundle.</p>
  {% endfor %}

  <h3 id="not-assessed">3.5 Not Assessed From This Bundle</h3>
  <p>The items below require data this tool cannot get from an ESXi vm-support bundle
     (EVC/cluster configuration, vCenter alarms, VM-level state) &mdash; they need a live vCenter
     connection or a vCenter-side export instead. They are listed here, rather than omitted, so a
     reviewer can see exactly what still needs checking manually, or strike any that don't apply.</p>
  <ul>{% for item in scope_not_assessed %}<li>{{ item }}</li>{% endfor %}</ul>
  {% if cluster_hosts %}
  <p>One real, host-reported data point that is adjacent to this: the following hosts locally
     report membership in a vCenter compute resource / cluster (this is not EVC or HA
     configuration, just a cluster ID each host's own agent knows about):</p>
  <ul>
    {% for h in cluster_hosts %}
    <li>{{ h.hostname }}: {{ h.cluster_id }}{% if h.cluster_in_alarm %} (local agent reports an alarm){% endif %}</li>
    {% endfor %}
  </ul>
  {% endif %}

  <h3 id="recommendation">3.6 Recommendation</h3>
  {% for g in recommendation_groups %}
  <div class="finding">
    <span class="badge {{ g.severity }}">{{ g.severity }}</span>
    <h3>{{ g.title }}</h3>
    <p><strong>Affected:</strong> {{ g.affected|join(", ") }}</p>
    <p><strong>Action:</strong> {{ g.action }}</p>
    {% if g.limitations %}<p class="muted"><strong>Limitations:</strong> {{ g.limitations }}</p>{% endif %}
  </div>
  {% else %}
  <p>No findings were raised, so there are no recommendations to track.</p>
  {% endfor %}
</section>

</main>
<footer>
  Generated offline by vhealth {{ assessment.metadata.app_version }}. No data from this bundle was
  transmitted anywhere.
</footer>
</body>
</html>
